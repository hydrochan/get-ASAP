# get-ASAP 환경변수 설정 템플릿
# 이 파일을 .env로 복사 후 실제 값을 입력하세요:
#   cp .env.example .env
#   nano .env

# ──────────────────────────────────────────────
# Gmail OAuth 설정
# ──────────────────────────────────────────────

# Google Cloud Console에서 다운로드한 OAuth 2.0 클라이언트 자격증명 파일 경로
GMAIL_CREDENTIALS_PATH=credentials.json

# OAuth 인증 완료 후 자동 생성되는 토큰 파일 경로 (로컬 인증 후 SCP로 서버 복사)
GMAIL_TOKEN_PATH=token.json

# ──────────────────────────────────────────────
# 정본 DB (SQLite) + 동기화 API
# ──────────────────────────────────────────────

# 정본 SQLite 파일 경로. 상대경로는 프로젝트 루트 기준. 비우면 data/asap.db
# 같은 폴더의 backups/ 에 일일 gzip 백업(backup_db.py)이 쌓인다.
ASAP_DB_PATH=

# paper_autodown(KIST PC)이 /api/sync/v1/ 을 호출할 때 쓰는 Bearer 토큰.
# 비워 두면 동기화 API 전체가 503 으로 비활성화된다. 충분히 긴 무작위 문자열을 쓰고,
# 같은 값을 PC 쪽 .env 에도 넣을 것: python -c "import secrets; print(secrets.token_urlsafe(48))"
ASAP_SYNC_TOKEN=

# ──────────────────────────────────────────────
# Notion 설정 (2026-10 이후 migrate_from_notion.py 일회성 이관 전용 - 운영 경로는 Notion을 쓰지 않는다)
# ──────────────────────────────────────────────

# Notion Integration Token (https://www.notion.so/my-integrations)
NOTION_TOKEN=

# 논문 저장 대상 데이터베이스 ID (없으면 NOTION_PARENT_PAGE_ID로 자동 생성)
NOTION_DATABASE_ID=

# DB 자동 생성 시 사용할 부모 페이지 ID (NOTION_DATABASE_ID 없을 때만 사용)
NOTION_PARENT_PAGE_ID=

# ──────────────────────────────────────────────
# 실행 설정
# ──────────────────────────────────────────────

# Gmail 체크 주기 (시간 단위, crontab과 일치시킬 것)
CHECK_INTERVAL_HOURS=6

# ──────────────────────────────────────────────
# 대시보드 인증 (다중 사용자)
# ──────────────────────────────────────────────

# 사용자명 → bcrypt 해시 매핑 (JSON 한 줄)
# 해시 생성: python -c "import bcrypt; print(bcrypt.hashpw(b'비밀번호', bcrypt.gensalt()).decode())"
# 예: DASHBOARD_USERS={"admin":"$2b$12$abc...","user1":"$2b$12$xyz..."}
DASHBOARD_USERS=

# 관리자 사용자명 목록 (쉼표 구분, Stats 탭 접근 권한 부여)
# 예: DASHBOARD_ADMINS=admin
DASHBOARD_ADMINS=

# Cloudflare Access(Zero Trust, Google 로그인) — /manage 관리자 진입. 세 값이 모두 있어야 켜진다.
# 설정 방법은 docs/access-login.md. 하나라도 비어 있으면 기존 nginx Basic 인증 경로만 동작한다.
# Zero Trust 팀 도메인 (JWT issuer 와 일치해야 함, 끝 슬래시 없이)
# 예: ACCESS_TEAM_DOMAIN=https://myteam.cloudflareaccess.com
ACCESS_TEAM_DOMAIN=
# Access 애플리케이션의 AUD 태그 (Zero Trust > Access > Applications > 해당 앱 > Overview)
ACCESS_AUD=
# 로그인 이메일 → 대시보드 사용자명 매핑 (JSON 한 줄). 사용자명은 DASHBOARD_ADMINS 에 있어야 한다.
# 예: ACCESS_EMAIL_USERS={"me@example.com":"admin"}
ACCESS_EMAIL_USERS=

# 사용자별 섹션 가시성 + 포커스 프로필 매핑 (JSON 한 줄)
# hidden_sections: 해당 유저에게 숨길 섹션 id 배열
# focus_profile: dashboard/server.py FOCUS_PROFILES 의 키 (없으면 null)
# 예: DASHBOARD_USER_PROFILES={"user1":{"hidden_sections":["section-interest-analysis"],"focus_profile":"hydrogen_carriers"}}
DASHBOARD_USER_PROFILES=

# ──────────────────────────────────────────────
# Cloudflare Pages 사본 (publish_pages.py, cron 4시간) - 월별 슬림 CSV 를 *.pages.dev 에도 올려 한국에서 빠르게 받게 한다
# 하나라도 비면 publish_pages.py 는 설정 오류로 끝난다(--dry-run 은 설정 없이도 동작). 서버(server.py)는 PAGES_BASE_URL·PUBLIC_FRONT_ON_PAGES 만 읽는다.
# ──────────────────────────────────────────────

# Pages 편집 권한만 있는 API 토큰과 계정 ID (절대 커밋 금지)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Pages 프로젝트 이름(소문자·숫자·하이픈)과 그 공개 주소 - 주소는 반드시 https://<프로젝트>.pages.dev 형식
PAGES_PROJECT=
PAGES_BASE_URL=
# wrangler 실행 파일 경로 (비우면 .tools/node/bin/wrangler, 상대경로는 프로젝트 루트 기준)
WRANGLER_BIN=
# 공개 화면을 Pages 에서 서빙할 때(publish_pages.py 가 index.html 도 올림). 서버가 PAGES_BASE_URL 을 읽어 그 출처에만 CORS 를 열고,
# PUBLIC_FRONT_ON_PAGES=1 이면 세션 없는 방문자의 GET / 를 Pages 로 302 한다(?stay=1 은 제외). 끄려면 0 또는 삭제 후 서버 재시작
PUBLIC_FRONT_ON_PAGES=

# ──────────────────────────────────────────────
# 레거시 (하위 호환용 · 신규 배포 시 불필요)
# ──────────────────────────────────────────────
# DASHBOARD_USERNAME=
# DASHBOARD_PASSWORD_HASH=
